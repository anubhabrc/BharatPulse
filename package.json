{
  "name": "bharatpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/database.test.ts tests/spatial.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "import:plan": "node --import tsx scripts/import.ts plan",
    "import:publish": "node --env-file-if-exists=.env --import tsx scripts/import.ts publish",
    "data:sync": "node --import tsx scripts/sync-notion.ts",
    "news:sync": "node --import tsx scripts/sync-news.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.1",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@electric-sql/pglite-postgis": "0.3.0",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
